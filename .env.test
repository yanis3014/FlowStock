# Override for integration tests: use Docker Postgres (localhost:5433, bmad/bmad)
# Loaded after .env by jest.setup.js (override: true)
# Force IPv4 + disable SSL to avoid localhost/IPv6/ssl auth mismatches in some environments.
DATABASE_URL=postgresql://bmad:bmad@127.0.0.1:5434/bmad_stock_agent?sslmode=disable
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=bmad
POSTGRES_PASSWORD=bmad
POSTGRES_DB=bmad_stock_agent
