# API Gateway Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (required for API, migrations, and integration tests)
# For local Docker: use bmad/bmad, port 5433 (Docker maps 5433->5432 to avoid conflict with local PostgreSQL)
# Ensure Postgres is running: docker-compose up -d postgres
DATABASE_URL=postgresql://bmad:bmad@localhost:5433/bmad_stock_agent
# Alternative: use separate vars (DATABASE_URL takes precedence if set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=bmad
POSTGRES_PASSWORD=bmad
POSTGRES_DB=bmad_stock_agent

# JWT Configuration (required for auth)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFICATION_EXPIRES_IN=24h
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# ML Service Configuration (optional for MVP)
ML_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=

# GCP Configuration (for deployment)
GCP_PROJECT_ID=
GCP_REGION=europe-west1
GCP_ARTIFACT_REGISTRY=bmad-stock-agent
GCP_SA_KEY=

# Application Configuration
APP_VERSION=0.1.0

# URL de l’app web (redirections OAuth Square après /auth/square/callback)
FRONTEND_APP_URL=http://localhost:3002

# Chiffrement des tokens OAuth en base (64 caractères hex = 32 octets). Obligatoire en production.
# TOKEN_ENCRYPTION_KEY=

# Square OAuth (Connect) — SQUARE_APPLICATION_SECRET uniquement ici, jamais dans le frontend.
# SQUARE_REDIRECT_URI doit être identique à l’URL du dashboard (ex. http://localhost:3000/auth/square/callback).
# SQUARE_APPLICATION_ID=
# SQUARE_APPLICATION_SECRET=
# SQUARE_REDIRECT_URI=http://localhost:3000/auth/square/callback
# SQUARE_USE_SANDBOX=true

# Optional: disable migrations on API startup (e.g. if you run them separately)
# RUN_MIGRATIONS_ON_STARTUP=false
